# Copy to `.env` and fill in your own FetLife credentials.
# The .env file is git-ignored and must never be committed.

FETLIFE_USERNAME=your_nickname_or_email
FETLIFE_PASSWORD=your_password

# Optional tuning
# Seconds between requests: each request waits a RANDOM interval in
# [min, max] (jitter is less bot-like than a fixed cadence). Legacy
# FETLIFE_RATE_LIMIT still works and sets both bounds to the same value.
FETLIFE_RATE_LIMIT_MIN=2.0
FETLIFE_RATE_LIMIT_MAX=5.0
# On HTTP 429/5xx, retry with exponential backoff before giving up. After a 429
# the client also stays slower for the rest of the run (the delay doubles, up to
# 8x), so these bounds are a starting point, not a ceiling. Widening them is
# rarely the fix for throttling — see "Rate limiting" in the README.
FETLIFE_MAX_RETRIES=4
FETLIFE_RETRY_BACKOFF=5.0
# Where the persisted session cookie jar is stored.
FETLIFE_SESSION_PATH=~/.fetlife/session.cookies
# Where the client remembers the delay it learned from past 429s, so a new run
# starts cautious instead of walking into the same wall. Discarded after 24h.
FETLIFE_THROTTLE_STATE_PATH=~/.fetlife/throttle.json
# Browser profile curl_cffi impersonates to clear Cloudflare (chrome, safari,
# edge, chrome124, ...). Change this if a profile stops working.
FETLIFE_IMPERSONATE=chrome
# Override the User-Agent. LEAVE UNSET: impersonation sets a matching browser
# UA, and a custom one re-triggers Cloudflare's bot block.
# FETLIFE_USER_AGENT=

# `discover` geocoding (OpenStreetMap Nominatim). Cache avoids re-querying places.
FETLIFE_GEOCODE_CACHE_PATH=~/.fetlife/geocode.json
# Nominatim's policy asks for a descriptive User-Agent identifying your app.
# FETLIFE_GEOCODER_USER_AGENT=FetLifeTools/0.1 (+https://github.com/you/FetLifeTools)
